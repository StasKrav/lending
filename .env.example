# ============================================================
# Настройки YandexGPT для лендинга StanKrav
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
# ============================================================

# API-ключ сервисного аккаунта Yandex Cloud (начинается с AQVN...)
# Как получить — см. README.md
YANDEX_API_KEY=

# ID каталога (folder) в Yandex Cloud, где включена YandexGPT
YANDEX_FOLDER_ID=

# Модель: yandexgpt-lite (быстрая) или yandexgpt (умнее)
YANDEX_MODEL=yandexgpt-lite

# Порт, на котором будет работать сервер
PORT=3000